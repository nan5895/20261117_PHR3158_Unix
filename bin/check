#!/bin/bash
# 자가 채점기:  check lab1 | lab2 | hw | all      (학번·이름 다시 입력: check reset)
# 정답은 해시(sha256)로만 저장되어 있어서, 이 파일을 읽어도 답은 보이지 않습니다 :)
# 채점 결과는 교수님의 구글 폼으로 자동 제출됩니다 (학번, 이름, GitHub ID, 실습, 결과)

# ---- 제출용 구글 폼 (강사가 설정) ----
FORM_URL=""                 # https://docs.google.com/forms/d/e/<폼ID>/formResponse
F_ID="";  F_NAME="";  F_GH="";  F_LAB="";  F_RESULT=""     # 각 문항의 entry.숫자
ME="$HOME/.phr3158_student"  # 학번·이름 저장 위치

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
W="$ROOT/work"; R="$W/results"; B="$W/bwa"
PASS=0; FAIL=0; MARKS=""
G=$'\e[32m'; X=$'\e[31m'; Y=$'\e[33m'; N=$'\e[0m'

sha() { if command -v sha256sum >/dev/null; then sha256sum | cut -c1-16; else shasum -a 256 | cut -c1-16; fi; }
ok()  { echo "  ${G}✔${N} $1"; PASS=$((PASS+1)); MARKS="${MARKS}O"; }
no()  { echo "  ${X}✘${N} $1"; [ -n "$2" ] && echo "    ${Y}힌트:${N} $2"; FAIL=$((FAIL+1)); MARKS="${MARKS}X"; }

# 결과 파일을 "정규화"한 뒤 해시 비교 — 공백/형식 차이는 너그럽게 봐줍니다
norm() {  # $1=방식 $2=파일
  case "$1" in
    num)    grep -oE -- '-?[0-9]+' "$2" | head -1 ;;
    base)   tr -d '\r' < "$2" | tr 'a-z' 'A-Z' | grep -oE '[ACGT]' | head -1 ;;
    mapped) grep -m1 ' mapped (' "$2" | grep -oE '^[0-9]+' ;;
  esac
}
expect() {  # $1=파일 $2=방식 $3=해시 $4=설명 $5=힌트
  local f="$R/$1"
  if [ ! -s "$f" ]; then no "$4 — work/results/$1 파일이 없거나 비어 있음" "$5"; return; fi
  if [ "$(norm "$2" "$f" | sha)" == "$3" ]; then ok "$4"; else no "$4 — 값이 다릅니다" "$5"; fi
}
exists() {  # $1=파일 $2=설명 $3=힌트
  [ -s "$1" ] && ok "$2" || no "$2 — ${1#$ROOT/} 파일이 없습니다" "$3"
}

lab1() {
  echo "▶ Lab 1: 서열 정렬"
  expect lab1_score.txt    num 53c234e5e8472b6a "Q1 AATC vs AAGC 정렬 점수" "python3 tools/align.py AATC AAGC | grep score > work/results/lab1_score.txt"
  expect lab1_mutation.txt num eea8254c7500ba3d "Q2 불일치 위치 (region 의 몇 번째 글자)" "--local 정렬 결과의 '불일치:' 줄에서 seq2 의 몇 번째인지 → echo 숫자 > work/results/lab1_mutation.txt"
}

lab2() {
  echo "▶ Lab 2: BWA + samtools"
  exists "$B/genome.fasta.bwt" "1. bwa index (참조 색인)"   "mkdir work/bwa → cp data/ref/genome.fasta work/bwa/ → bwa index work/bwa/genome.fasta"
  exists "$B/sample1.bam"      "3. samtools sort (BAM 파일)" "samtools sort -o work/bwa/sample1.bam work/bwa/sample1.sam"
  exists "$B/sample1.bam.bai"  "3. samtools index (BAM 색인)" "samtools index work/bwa/sample1.bam"
  expect lab2_flagstat.txt mapped f5aee7df0c39c948 "Q1 flagstat 결과" "samtools flagstat work/bwa/sample1.bam > work/results/lab2_flagstat.txt"
  expect lab2_base.txt     base   12f37a8a84034d3e "Q2 chr2:1500 에서 리드들이 읽은 글자" "tview 화면의 맨 왼쪽 세로줄. '.' ',' 가 아니라 '글자'가 적힌 줄을 보세요"
}

hw() {
  echo "▶ 숙제: 스크립트로 sample2 분석"
  sed 's/#.*//' "$ROOT/scripts/wgs_pipeline.sh" | grep -q '____' \
    && no "scripts/wgs_pipeline.sh 에 빈칸(____)이 남아 있습니다" "빈칸을 채우고 Ctrl+S 로 저장" \
    || ok "스크립트 빈칸 채우기"
  expect hw_flagstat.txt mapped 58bdc6c4a0bea735 "Q1 sample2 flagstat (스크립트가 자동 저장)" "bash scripts/wgs_pipeline.sh 를 실행하면 자동으로 만들어집니다"
  expect hw_base.txt     base   678f81a714fbc720 "Q2 sample2 의 chr2:1500 글자" "모두 '.' ',' 라면 참조와 같다는 뜻 → 참조(둘째 줄) 글자를 적으세요"
}

clue() {  # 통과하면 다음 이야기
  [ "$FAIL" -eq 0 ] || return
  case "$1" in
    lab1) echo ""; echo "${Y}🤔 리드 1개에서 불일치 1개를 찾았습니다. 시퀀싱 오류일까요, 진짜 변이일까요?${N}"
          echo "   리드 1개로는 알 수 없습니다 → 리드 3천 개를 정렬해서 쌓아 봅시다:  labs/lab2_bwa_samtools.md" ;;
    lab2) echo ""; echo "${G}🎉 sample1 의 chr2:1500 은 모든 리드가 같은 글자 → 시퀀싱 오류가 아니라 진짜 변이(SNV)!${N}"
          echo "   숙제: labs/homework.md   (실제 분석에서는 다음 단계로 bcftools 같은 변이 호출 프로그램을 씁니다)" ;;
    hw)   echo ""; echo "${G}🎉 숙제 완료! sample1 과 sample2 를 비교해 보세요.${N}" ;;
  esac
}

whoami_ask() {  # 처음 한 번만 학번·이름 입력
  [ -s "$ME" ] && return 0
  [ -t 0 ] || return 1                         # 자동 채점(CI) 등 입력이 없는 환경에서는 묻지 않음
  echo "${Y}📝 처음 한 번만 입력합니다. (채점 결과가 교수님께 자동으로 제출됩니다)${N}"
  local sid name yn
  while true; do
    read -r -p "   학번: " sid; sid="${sid//[^0-9]/}"
    read -r -p "   이름: " name
    [ -n "$sid" ] && [ -n "$name" ] || { echo "   학번(숫자)과 이름을 모두 입력하세요."; continue; }
    read -r -p "   ${sid} ${name} — 맞나요? (y/n) " yn
    [[ "$yn" == [yYㅛ]* ]] && break
  done
  printf '%s\t%s\n' "$sid" "$name" > "$ME"
}

submit() {  # $1 = lab 이름
  [ -n "$FORM_URL" ] || return 0
  whoami_ask || return 0
  local sid name gh code
  IFS=$'\t' read -r sid name < "$ME"
  gh="${GITHUB_USER:-$(git -C "$ROOT" config user.name 2>/dev/null)}"
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "$FORM_URL" \
    --data-urlencode "$F_ID=$sid" --data-urlencode "$F_NAME=$name" --data-urlencode "$F_GH=$gh" \
    --data-urlencode "$F_LAB=$1" --data-urlencode "$F_RESULT=$PASS/$((PASS+FAIL)) $MARKS")
  if [ "$code" == "200" ]; then
    echo "📨 제출 완료 ($sid $name · $1 $PASS/$((PASS+FAIL)))   다시 check 하면 마지막 결과로 덮어씁니다"
  else
    echo "${Y}⚠️  자동 제출 실패 (인터넷 확인). 이 화면을 캡처해서 i-Campus 에 올려 주세요.${N}"
  fi
}

case "$1" in
  __hash) norm "$2" "$3" | sha; exit 0 ;;
  reset) rm -f "$ME"; whoami_ask; exit 0 ;;
  lab1|lab2|hw) "$1"; clue "$1" ;;
  all) lab1; lab2; hw ;;
  *) echo "사용법: check lab1 | lab2 | hw | all      (학번·이름 다시 입력: check reset)"; exit 2 ;;
esac
echo ""; echo "결과: ${G}${PASS} 통과${N}, ${X}${FAIL} 실패${N}"
submit "$1"
[ "$FAIL" -eq 0 ]
